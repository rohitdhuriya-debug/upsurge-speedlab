# Python
.venv/
__pycache__/
*.pyc

# SpeedLab runtime data - your media and your processing history, never published
inbox/*
outbox/*
work/*
logs/*
manifests/*
*.db
*.db-wal
*.db-shm

# keep the folder structure, not the contents
!.gitkeep

# test / demo scratch roots
selftest_run/
demo_run/
deltest/
scratch_ui/

# editor / OS
.DS_Store
.claude/settings.local.json

# explicitly track the empty-folder markers
!inbox/.gitkeep
!outbox/.gitkeep
!work/.gitkeep
!work/thumbs/.gitkeep
!logs/.gitkeep
!manifests/.gitkeep

# local secrets and container state
.env
data/
